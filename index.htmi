<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>모노폴리 무기 숙련도 재분배 룰렛</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="container">
    <h1>모노폴리 무기 숙련도 재분배 룰렛</h1>

    <div class="card">

      <table>
        <tr>
          <th colspan="2">
            <input type="text" class="name-input" value="이름">
          </th>
        </tr>

        <tr>
          <td class="left">강점</td>
          <td>
            <input type="text" id="strongInput" placeholder="쉼표로 구분">
          </td>
        </tr>

        <tr>
          <td class="left">보통</td>
          <td>
            <input type="text" id="normalInput" placeholder="쉼표로 구분">
          </td>
        </tr>

        <tr>
          <td class="left">약점</td>
          <td>
            <input type="text" id="weakInput" placeholder="쉼표로 구분">
          </td>
        </tr>
      </table>

    </div>

    <button id="spinBtn">룰렛 돌리기</button>

    <div class="result-box">
      <h2>결과:</h2>

      <div id="mainResult" class="main-result">
        A ↔ B
      </div>

      <div id="detailResult" class="detail-result">
        강점: A → B<br>
        약점: B → A
      </div>
    </div>

  </div>

  <script src="script.js"></script>
</body>
</html>
